  "deviations": [
    {
      "what": "The four request.user-dependent TestPricingTable cases (T012) use the cotton_render_string fixture with an explicit context={\"request\": request}, instead of the cotton_render fixture the rest of the class and file use.",
      "why": "cotton_render's render_component always resolves the request context key from its own fixed, anonymous RequestFactory request via the request context processor, which is looked up ahead of anything passed through context or kwargs -- there is no way to attach a signed-in user's request through it. cotton_render_string builds a plain Context with no processors and sets context[\"request\"] from what the caller supplies, so a test's authenticated request is the one the template actually sees.",
      "decision_ref": "decisions.md D5"
    }
  ],
