  "deviations": [
    {
      "what": "T023 changed no production code.",
      "why": "T021's probes (zeroing build_plan's features, then widening the feature query to every product) showed SubscriptionReader.build_plan already carries the right features, correctly isolated per product, with the right description fallback. The brief named this as a correct outcome, not a shortfall.",
      "decision_ref": "specs/002-subscription-page/progress.md#2026-09-22T05:12:09Z-implementer-us3-t023"
    },
    {
      "what": "plan.html's border and vertical padding moved from the name/amount row onto a new outer wrapper div, rather than adding the features block as a sibling.",
      "why": "The border marks the boundary between plans in subscription.html's loop. Left on the original row, adding features as a sibling after it would put the border between a plan's own row and its own features instead.",
      "decision_ref": "specs/002-subscription-page/decisions.md#d12-planhtmls-border-moved-to-an-outer-wrapper-when-features-were-added"
    },
    {
      "what": "features.html applies feature.description|default:feature.identifier itself, even though build_plan already performs that fallback before the template ever sees a PlanFeature.",
      "why": "T022's acceptance is stated for the component alone, and FR-012/SC-006 require every component to render correctly from its own attributes independent of how they were produced.",
      "decision_ref": "specs/002-subscription-page/decisions.md#d13-featureshtml-renders-featuredescriptiondefaultfeatureidentifier-not-a-fallback-baked-into-planfeature"
    }
  ],
