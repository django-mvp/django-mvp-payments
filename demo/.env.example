# Copy this file to demo/.env and fill in values from your own Stripe sandbox.
# demo/.env is gitignored: never commit real values, here or anywhere else.
#
# Every entry is optional. Anything left out falls back to an obviously fake
# value, the demo still runs, and the page that needs it says it could not
# reach the provider. Each can also be set as an ordinary environment
# variable, which takes precedence over this file.

# Secret key. Stripe Dashboard, sandbox mode: Developers > API keys.
# Lets "Manage subscription" and "Switch plans" open the hosted billing
# portal, and lets `manage.py seed_demo` create real sandbox customers and
# subscriptions for the demo accounts, on the cheapest monthly price there.
#
# For "Switch plans" to offer anything, list the plans a subscriber may move
# between in Settings > Billing > Customer portal, under subscription updates.
STRIPE_TEST_SECRET_KEY=

# Webhook signing secret. The Stripe app records subscriptions from Stripe's webhooks, and a
# sandbox cannot reach a development server, so forward them with the Stripe CLI:
#
#   stripe listen --forward-to localhost:8020/account/billing/stripe/webhook/ \
#     --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed,customer.deleted
#
# It prints "Your webhook signing secret is whsec_...". Put that value here and restart the
# demo. The secret stays the same for as long as the CLI is logged in to the same account, so
# this is done once. Without the command running the demo still starts, and subscribing in the
# sandbox simply does not reach it. Run `manage.py stripe_sync` to catch up afterwards.
# Change the port if you run the demo on another one.
STRIPE_TEST_WEBHOOK_SECRET=

# Publishable key, on the same page as the secret key.
# The Plans page's embedded pricing table needs it.
STRIPE_TEST_PUBLISHABLE_KEY=

# Pricing table ID. Stripe Dashboard, sandbox mode: Product catalog >
# Pricing tables. Tables can only be created in the Dashboard, not through
# the API. Must belong to the same account as the publishable key.
#
# In the table's payment settings, redirect customers to your website after
# payment, at <DEMO_BASE_URL>/account/billing/return/. That brings a buyer
# back to their subscription page with what they just bought on it.
STRIPE_TEST_PRICING_TABLE_ID=

# Where the provider sends a reader back to. Set this if you reach the
# development server by a hostname rather than localhost.
DEMO_BASE_URL=http://localhost:8020
